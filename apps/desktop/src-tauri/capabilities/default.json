{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main RustGit window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "dialog:allow-open",
    "allow-git-info",
    "allow-get-settings",
    "allow-set-theme",
    "allow-list-repositories",
    "allow-add-repository",
    "allow-init-repository",
    "allow-open-repository",
    "allow-set-repository-pinned",
    "allow-remove-repository",
    "allow-repository-status",
    "allow-stage-paths",
    "allow-unstage-paths",
    "allow-stage-all",
    "allow-unstage-all",
    "allow-discard-paths",
    "allow-file-diff",
    "allow-apply-hunk",
    "allow-change-totals",
    "allow-author-identity",
    "allow-last-commit-message",
    "allow-create-commit",
    "allow-command-history"
  ]
}
