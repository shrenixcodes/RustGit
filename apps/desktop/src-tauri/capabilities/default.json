{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main RustGit window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "dialog:allow-open",
    "allow-git-info",
    "allow-respond-credential",
    "allow-github-status",
    "allow-github-start-sign-in",
    "allow-github-cancel-sign-in",
    "allow-github-sign-out",
    "allow-github-list-repositories",
    "allow-github-create-repository",
    "allow-get-settings",
    "allow-set-theme",
    "allow-list-repositories",
    "allow-add-repository",
    "allow-init-repository",
    "allow-open-repository",
    "allow-set-repository-pinned",
    "allow-remove-repository",
    "allow-repository-status",
    "allow-stage-paths",
    "allow-unstage-paths",
    "allow-stage-all",
    "allow-unstage-all",
    "allow-discard-paths",
    "allow-file-diff",
    "allow-apply-hunk",
    "allow-change-totals",
    "allow-create-commit",
    "allow-command-history",
    "allow-commit-context",
    "allow-log-page",
    "allow-commit-details",
    "allow-commit-file-diff",
    "allow-compare-revisions",
    "allow-compare-file-diff",
    "allow-list-refs",
    "allow-create-branch",
    "allow-checkout-branch",
    "allow-rename-branch",
    "allow-delete-branch",
    "allow-set-upstream",
    "allow-merge-branch",
    "allow-rebase-branch",
    "allow-cherry-pick",
    "allow-revert-commit",
    "allow-continue-operation",
    "allow-abort-operation",
    "allow-conflict-versions",
    "allow-resolve-conflict",
    "allow-list-remotes",
    "allow-add-remote",
    "allow-set-remote-url",
    "allow-remove-remote",
    "allow-start-fetch",
    "allow-start-pull",
    "allow-start-push",
    "allow-start-delete-remote-branch",
    "allow-start-clone",
    "allow-cancel-operation",
    "allow-list-stashes",
    "allow-create-stash",
    "allow-apply-stash",
    "allow-drop-stash",
    "allow-stash-details",
    "allow-stash-file-diff",
    "allow-list-worktrees",
    "allow-add-worktree",
    "allow-remove-worktree",
    "allow-prune-worktrees",
    "allow-watch-repository",
    "allow-unwatch-repository"
  ]
}
